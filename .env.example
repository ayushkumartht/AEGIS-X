# Copy this file to .env and fill in your own keys. .env is gitignored: never commit a real key.
# The backend loads it automatically (backend/aegis/settings.py).

AEGIS_ENV=dev                       # dev | demo | prod
AEGIS_OFFLINE=false                 # true = never call external APIs, use cached data only
AEGIS_CORS_ORIGINS=http://localhost:5173
AEGIS_CORS_ORIGIN_REGEX=            # optional, e.g. https://aegis-x-.*\.vercel\.app
# AEGIS_DB_URL=sqlite:////var/data/aegis.db   # default: data/aegis.db in the repo

# Accounts: the admin below is created on start. Sign in at /login.
AEGIS_SECRET_KEY=                   # long random string; required when AEGIS_ENV=prod
AEGIS_ADMIN_EMAIL=
AEGIS_ADMIN_PASSWORD=

# Command Center: poll live alerts (every 10 min) and river risk (every 3 h) in the background.
# Turn on in exactly one process.
AEGIS_OPS_POLL=false

# Limits for the compute-heavy endpoints on a public site
AEGIS_RATE_LIMIT_PER_MIN=30         # per visitor IP; 0 = off
AEGIS_MAX_HEAVY_JOBS=2              # simulations running at the same time

LLM_PROVIDER=groq                   # groq | gemini | claude | none
LLM_MODEL=                          # empty = provider default
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

HTTP_USER_AGENT=AEGIS-X/0.2
